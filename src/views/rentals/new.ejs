<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <title>Nowe wypożyczenie</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include("../partials/nav") %>
    <main>
      <h1>Nowe wypożyczenie</h1>
      <% if (errors.length) { %>
      <ul>
        <% errors.forEach(err => { %>
        <li class="alert"><%= err.msg %></li>
        <% }) %>
      </ul>
      <% } %>
      <form method="post" action="/rentals">
        <input name="customerName" placeholder="Imię" value="<%= rental.customerName || "" %>" />
        <input name="customerEmail" placeholder="Email" value="<%= rental.customerEmail || "" %>" />
        <select name="movieId">
          <option value="">Wybierz film</option>
          <% movies.forEach(movie => { %>
          <option value="<%= movie._id %>" <%= rental.movieId === String(movie._id) ? "selected" : "" %>>
            <%= movie.title %> (na stanie: <%= movie.stock %>)
          </option>
          <% }) %>
        </select>
        <input type="number" name="days" placeholder="Ile dni" value="<%= rental.days || 1 %>" />
        <button type="submit">Wypożycz</button>
      </form>
    </main>
  </body>
</html>
